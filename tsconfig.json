{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // "tsx": "react-native",
    // "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@tanstack/react-query": [
        "./node_modules/@tanstack/react-query/build/modern/index"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}